# ---------------------------------------------------------------------------
# Database — Neon PostgreSQL
# Get this from `neon connection-string production` or the Neon dashboard.
# Use the POOLED connection string (host contains "-pooler") on Vercel.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Direct (unpooled) connection, used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# ---------------------------------------------------------------------------
# Admin auth — CHANGE BOTH BEFORE DEPLOYING
# ---------------------------------------------------------------------------
# Signing key for the admin session cookie. Must be >= 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Seeded admin login (used once by `npm run db:seed`).
ADMIN_EMAIL="admin@sos.cafe"
ADMIN_PASSWORD="choose-a-strong-password"
